<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Autohaus Panama shipping methods (weight-based rules).

            The price is computed by rule from the cart weight in pounds
            (rounded up): the FinditParts domestic US rate (the base) plus a
            markup per billable pound. The commercial markup is read from the
            active finditparts.config (or the matching ir.config_parameter).
            These are internal records: the markup is never exposed to the
            customer.

            No country_ids are set because the checkout warehouse selection
            (not the partner country) determines the destination; filtering is
            handled by sale.order._get_delivery_methods.
        -->

        <!-- Ground · aéreo -->
        <record id="carrier_panama_ground" model="delivery.carrier">
            <field name="name">Ground · aéreo (Panamá)</field>
            <field name="delivery_type">base_on_rule</field>
            <field name="sequence">10</field>
            <field name="panama_service_type">ground</field>
            <field name="weight_unit">lb</field>
            <field name="is_published">True</field>
            <field name="product_id" ref="delivery.product_product_delivery"/>
        </record>

        <!-- Rápido · aéreo -->
        <record id="carrier_panama_rapido" model="delivery.carrier">
            <field name="name">Rápido · aéreo (Panamá)</field>
            <field name="delivery_type">base_on_rule</field>
            <field name="sequence">20</field>
            <field name="panama_service_type">rapido</field>
            <field name="weight_unit">lb</field>
            <field name="is_published">True</field>
            <field name="product_id" ref="delivery.product_product_delivery"/>
        </record>

        <!-- Flash · aéreo -->
        <record id="carrier_panama_flash" model="delivery.carrier">
            <field name="name">Flash · aéreo (Panamá)</field>
            <field name="delivery_type">base_on_rule</field>
            <field name="sequence">30</field>
            <field name="panama_service_type">flash</field>
            <field name="weight_unit">lb</field>
            <field name="is_published">True</field>
            <field name="product_id" ref="delivery.product_product_delivery"/>
        </record>

        <!-- Marítimo · LCL (quoted manually: no dimensions from API) -->
        <record id="carrier_panama_lcl" model="delivery.carrier">
            <field name="name">Marítimo · LCL (Panamá)</field>
            <field name="delivery_type">base_on_rule</field>
            <field name="sequence">40</field>
            <field name="panama_service_type">lcl</field>
            <field name="weight_unit">lb</field>
            <field name="is_published">True</field>
            <field name="active" eval="False"/>
            <field name="product_id" ref="delivery.product_product_delivery"/>
        </record>

        <!--
            Reglas de precio por peso (USD por libra facturable).

            Precio = list_base_price + list_price * peso (en lb). La tarifa base
            es la tarifa de envío doméstico dentro de Estados Unidos que reporta
            FinditParts y se inyecta dinámicamente por el motor de cotización
            (list_base_price queda en 0 aquí). El markup comercial es de
            US$3.75 por cada libra facturable (redondeada hacia arriba por el
            motor de envío).
        -->
        <record id="price_rule_panama_ground" model="delivery.price.rule">
            <field name="carrier_id" ref="carrier_panama_ground"/>
            <field name="sequence">10</field>
            <field name="variable">weight</field>
            <field name="operator">&gt;=</field>
            <field name="max_value">0</field>
            <field name="list_base_price">0.0</field>
            <field name="list_price">3.75</field>
            <field name="variable_factor">weight</field>
        </record>

        <record id="price_rule_panama_rapido" model="delivery.price.rule">
            <field name="carrier_id" ref="carrier_panama_rapido"/>
            <field name="sequence">10</field>
            <field name="variable">weight</field>
            <field name="operator">&gt;=</field>
            <field name="max_value">0</field>
            <field name="list_base_price">0.0</field>
            <field name="list_price">3.75</field>
            <field name="variable_factor">weight</field>
        </record>

        <record id="price_rule_panama_flash" model="delivery.price.rule">
            <field name="carrier_id" ref="carrier_panama_flash"/>
            <field name="sequence">10</field>
            <field name="variable">weight</field>
            <field name="operator">&gt;=</field>
            <field name="max_value">0</field>
            <field name="list_base_price">0.0</field>
            <field name="list_price">3.75</field>
            <field name="variable_factor">weight</field>
        </record>

        <!--
            Fallback configuration via ir.config_parameter. The active
            finditparts.config fields take precedence; these values ensure a
            consistent default on Odoo.sh and local Docker.
        -->
        <record id="config_markup_per_lb" model="ir.config_parameter">
            <field name="key">autohaus_shipping.markup_per_lb</field>
            <field name="value">3.75</field>
        </record>
        <record id="config_enable_ground" model="ir.config_parameter">
            <field name="key">autohaus_shipping.enable_panama_ground</field>
            <field name="value">True</field>
        </record>
        <record id="config_enable_rapido" model="ir.config_parameter">
            <field name="key">autohaus_shipping.enable_panama_rapido</field>
            <field name="value">True</field>
        </record>
        <record id="config_enable_flash" model="ir.config_parameter">
            <field name="key">autohaus_shipping.enable_panama_flash</field>
            <field name="value">True</field>
        </record>
        <record id="config_enable_lcl" model="ir.config_parameter">
            <field name="key">autohaus_shipping.enable_panama_lcl</field>
            <field name="value">False</field>
        </record>
    </data>
</odoo>
