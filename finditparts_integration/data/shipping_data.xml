<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Autohaus Panama shipping methods.

            Base rates always come from the FinditParts API at quote time; the
            records below only carry the service type and a zero fixed price.
            The commercial markup (USD per billable pound) is read from the
            active finditparts.config (or the matching ir.config_parameter) and
            applied by the quoting engine. These are internal records: the
            markup and base rate are never exposed to the customer.
        -->

        <!-- Ground · aéreo -->
        <record id="carrier_panama_ground" model="delivery.carrier">
            <field name="name">Ground · aéreo (Panamá)</field>
            <field name="delivery_type">fixed</field>
            <field name="fixed_price">0.0</field>
            <field name="sequence">10</field>
            <field name="panama_service_type">ground</field>
            <field name="weight_unit">lb</field>
            <field name="is_published">True</field>
            <field name="product_id" ref="delivery.product_product_delivery"/>
            <field name="country_ids" eval="[(4, ref('base.pa'))]"/>
        </record>

        <!-- Rápido · aéreo -->
        <record id="carrier_panama_rapido" model="delivery.carrier">
            <field name="name">Rápido · aéreo (Panamá)</field>
            <field name="delivery_type">fixed</field>
            <field name="fixed_price">0.0</field>
            <field name="sequence">20</field>
            <field name="panama_service_type">rapido</field>
            <field name="weight_unit">lb</field>
            <field name="is_published">True</field>
            <field name="product_id" ref="delivery.product_product_delivery"/>
            <field name="country_ids" eval="[(4, ref('base.pa'))]"/>
        </record>

        <!-- Flash · aéreo -->
        <record id="carrier_panama_flash" model="delivery.carrier">
            <field name="name">Flash · aéreo (Panamá)</field>
            <field name="delivery_type">fixed</field>
            <field name="fixed_price">0.0</field>
            <field name="sequence">30</field>
            <field name="panama_service_type">flash</field>
            <field name="weight_unit">lb</field>
            <field name="is_published">True</field>
            <field name="product_id" ref="delivery.product_product_delivery"/>
            <field name="country_ids" eval="[(4, ref('base.pa'))]"/>
        </record>

        <!-- Marítimo · LCL (quoted manually: no dimensions from API) -->
        <record id="carrier_panama_lcl" model="delivery.carrier">
            <field name="name">Marítimo · LCL (Panamá)</field>
            <field name="delivery_type">fixed</field>
            <field name="fixed_price">0.0</field>
            <field name="sequence">40</field>
            <field name="panama_service_type">lcl</field>
            <field name="weight_unit">lb</field>
            <field name="is_published">True</field>
            <field name="active" eval="False"/>
            <field name="product_id" ref="delivery.product_product_delivery"/>
            <field name="country_ids" eval="[(4, ref('base.pa'))]"/>
        </record>

        <!--
            Fallback configuration via ir.config_parameter. The active
            finditparts.config fields take precedence; these values ensure a
            consistent default on Odoo.sh and local Docker.
        -->
        <record id="config_markup_per_lb" model="ir.config_parameter">
            <field name="key">autohaus_shipping.markup_per_lb</field>
            <field name="value">2.50</field>
        </record>
        <record id="config_enable_ground" model="ir.config_parameter">
            <field name="key">autohaus_shipping.enable_panama_ground</field>
            <field name="value">True</field>
        </record>
        <record id="config_enable_rapido" model="ir.config_parameter">
            <field name="key">autohaus_shipping.enable_panama_rapido</field>
            <field name="value">True</field>
        </record>
        <record id="config_enable_flash" model="ir.config_parameter">
            <field name="key">autohaus_shipping.enable_panama_flash</field>
            <field name="value">True</field>
        </record>
        <record id="config_enable_lcl" model="ir.config_parameter">
            <field name="key">autohaus_shipping.enable_panama_lcl</field>
            <field name="value">False</field>
        </record>
    </data>
</odoo>
