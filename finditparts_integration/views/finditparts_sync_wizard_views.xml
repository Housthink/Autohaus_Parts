<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Sync Wizard Form View -->
    <record id="view_finditparts_product_sync_wizard_form" model="ir.ui.view">
        <field name="name">finditparts.product.sync.wizard.form</field>
        <field name="model">finditparts.product.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Products from API">
                <header>
                    <button name="action_sync_products" 
                            string="Start Sync" 
                            type="object" 
                            class="btn-primary"/>
                    <button name="action_view_created_products" 
                            string="View FinditParts Products" 
                            type="object" 
                            class="btn-secondary"/>
                    <button name="action_view_odoo_products" 
                            string="View Odoo Products" 
                            type="object" 
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="sync_type" widget="radio" options="{'horizontal': true}"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="search_query"/>
                            <field name="part_number"/>
                            <field name="limit"/>
                        </group>
                        <group>
                            <field name="auto_create_odoo_products"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Sync Results">
                            <group>
                                <group>
                                    <field name="created_count" readonly="1"/>
                                    <field name="updated_count" readonly="1"/>
                                    <field name="error_count" readonly="1"/>
                                </group>
                            </group>
                            <field name="sync_results" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Product Sync Wizard -->
    <record id="action_finditparts_product_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync Products from API</field>
        <field name="res_model">finditparts.product.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_finditparts_product_sync_wizard_form"/>
    </record>

</odoo>

