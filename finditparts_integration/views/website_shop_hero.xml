<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ==================================================================
         Autohaus Parts - Hero banner del home
         Titulo + subtitulo + CTA + distintivos. Solo se muestra en "/".
         ================================================================== -->
    <template id="autohaus_shop_hero"
              inherit_id="portal.frontend_layout"
              name="Autohaus Home Hero"
              priority="45">

        <!-- Arriba del contenido de la pagina -->
        <xpath expr="//main" position="before">
            <!-- Solo en el home; la tienda (/shop) ya no lleva hero -->
            <t t-set="autohaus_home_path" t-value="request.httprequest.path"/>
            <section t-if="autohaus_home_path == '/'"
                     class="o_autohaus_hero">
                <!-- Fondo del banner. La imagen viaja con el modulo (no depende de la BD),
                         asi funciona igual en local, Odoo.sh o cualquier entorno. -->
                <img class="o_autohaus_hero_bg"
                     src="/finditparts_integration/static/img/hero.jpg"
                     alt="Camiones y motores"
                     loading="eager"/>
                <span class="o_autohaus_hero_overlay" aria-hidden="true"/>

                <div class="o_autohaus_hero_inner">

                    <!-- Texto -->
                    <div class="o_autohaus_hero_text">
                        <h1 class="o_autohaus_hero_title">
                            <span class="o_autohaus_hero_title_top">Repuestos que</span>
                            <span class="o_autohaus_hero_title_bottom">mueven tu operaci&#243;n</span>
                        </h1>

                        <p class="o_autohaus_hero_subtitle">
                            Amplio cat&#225;logo de piezas para camiones de trabajo pesado,
                            equipo industrial y flotas comerciales.
                        </p>

                        <div class="o_autohaus_hero_actions">
                            <a href="/shop" class="o_autohaus_hero_cta">
                                <i class="fa fa-search" role="presentation"/>
                                <span>Buscar repuestos</span>
                                <i class="fa fa-arrow-right" role="presentation"/>
                            </a>
                            <span class="o_autohaus_hero_sync">Informaci&#243;n en Tiempo Real</span>
                        </div>

                        <!-- Distintivos -->
                        <ul class="o_autohaus_hero_badges">
                            <li>
                                <i class="fa fa-truck"/>
                                <span>Entregas confiables</span>
                            </li>
                            <li>
                                <i class="fa fa-shield"/>
                                <span>Garant&#237;a en repuestos</span>
                            </li>
                            <li>
                                <i class="fa fa-cogs"/>
                                <span>Soporte especializado</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>