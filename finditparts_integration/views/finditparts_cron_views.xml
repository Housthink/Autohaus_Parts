<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_finditparts_sync_cron_form" model="ir.ui.view">
            <field name="name">finditparts.sync.cron.form</field>
            <field name="model">finditparts.sync.cron</field>
            <field name="arch" type="xml">
                <form string="FinditParts Scheduled Sync" create="true" edit="true">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="FinditParts Sync"/></h1>
                        </div>
                        <group>
                            <group string="Sync Parameters">
                                <field name="sync_type" widget="radio" options="{'horizontal': true}"/>
                                <field name="search_query" invisible="sync_type != 'search'" required="sync_type == 'search'"/>
                                <field name="part_number" invisible="sync_type != 'part_number'" required="sync_type == 'part_number'"/>
                                <field name="limit" readonly="sync_type == 'part_number'"/>
                                <field name="config_id"/>
                            </group>
                            <group string="Schedule">
                                <label for="interval_number" string="Repeat every"/>
                                <div class="o_row">
                                    <field name="interval_number" class="oe_inline"/>
                                    <field name="interval_type" class="oe_inline"/>
                                </div>
                                <field name="active"/>
                                <field name="ir_cron_id" readonly="1"/>
                                <field name="next_execution" readonly="1"/>
                            </group>
                        </group>
                        <group string="Last Run">
                            <field name="last_run" readonly="1"/>
                            <field name="last_status" readonly="1"/>
                            <field name="last_created" readonly="1"/>
                            <field name="last_updated" readonly="1"/>
                            <field name="last_errors_count" readonly="1"/>
                            <field name="last_result" readonly="1" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_finditparts_sync_cron_tree" model="ir.ui.view">
            <field name="name">finditparts.sync.cron.tree</field>
            <field name="model">finditparts.sync.cron</field>
            <field name="arch" type="xml">
                <list string="FinditParts Scheduled Syncs" create="true" edit="true">
                    <field name="name"/>
                    <field name="sync_type"/>
                    <field name="search_query"/>
                    <field name="part_number"/>
                    <field name="limit"/>
                    <field name="interval_number"/>
                    <field name="interval_type"/>
                    <field name="next_execution"/>
                    <field name="last_status"/>
                    <field name="last_created"/>
                    <field name="last_updated"/>
                    <field name="last_errors_count"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_finditparts_sync_cron_search" model="ir.ui.view">
            <field name="name">finditparts.sync.cron.search</field>
            <field name="model">finditparts.sync.cron</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>

                    <filter string="Search Syncs" name="sync_type_search" domain="[('sync_type', '=', 'search')]"/>
                    <filter string="Part Number Syncs" name="sync_type_part_number" domain="[('sync_type', '=', 'part_number')]"/>
                    <filter string="All Products Syncs" name="sync_type_all" domain="[('sync_type', '=', 'all')]"/>

                    <separator/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>

                    <group>
                        <filter string="Sync Type" name="group_by_sync_type" context="{'group_by': 'sync_type'}"/>
                        <filter string="Active" name="group_by_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_finditparts_sync_cron" model="ir.actions.act_window">
            <field name="name">Sync Crons</field>
            <field name="res_model">finditparts.sync.cron</field>
            <field name="view_mode">list,form</field>
            <field name="target">current</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_finditparts_sync_cron"
                  name="Sync Crons"
                  parent="menu_finditparts_root"
                  action="action_finditparts_sync_cron"
                  sequence="25"/>
    </data>
</odoo>
