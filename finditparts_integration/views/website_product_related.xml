<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ==================================================================
         Autohaus Parts - Productos alternos (relacionados)
         Solo se muestra si el producto tiene alternative_product_ids,
         que es el comportamiento nativo de Odoo.
         ================================================================== -->
    <template id="autohaus_alternative_products"
              inherit_id="website_sale.product"
              name="Autohaus Alternative Products"
              priority="45">

        <!-- Titulo en espanol + diseno de la imagen -->
        <xpath expr="//section[hasclass('o_wsale_alternative_products')]//h4"
              position="replace">
            <h4 class="o_autohaus_alt_title">Productos relacionados</h4>
        </xpath>

        <xpath expr="//section[hasclass('o_wsale_alternative_products')]//p[hasclass('lead')]"
              position="replace">
            <p class="o_autohaus_alt_sub o_not_editable">
                Estos productos tambien pueden interesarte
            </p>
        </xpath>
    </template>

    <!-- Tarjetas: el snippet dinamico vive en un archivo de datos aparte -->
    <template id="autohaus_alternative_card"
              inherit_id="website_sale.dynamic_filter_template_product_product_products_item"
              name="Autohaus Alternative Product Card"
              priority="45">

        <xpath expr="//div[hasclass('oe_product_cart')]" position="replace">
            <t t-set="product_template" t-value="record if not record.is_product_variant else record.product_tmpl_id"/>
            <t t-set="product_variant" t-value="record if record.is_product_variant else record.product_variant_id"/>
            <t t-set="product" t-value="product_template"/>
            <t t-set="card_mode" t-value="'related'"/>
            <t t-set="display_name" t-value="data.get('display_name') or product_template.name"/>
            <t t-set="product_href" t-value="product_template.website_url"/>
            <t t-set="image_url" t-value="data.get('image_512')"/>
            <t t-call="finditparts_integration.autohaus_product_card"/>
        </xpath>
    </template>
</odoo>
