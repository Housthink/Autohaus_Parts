<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tarjeta de producto compartida por la tienda, los relacionados y Best Sellers.
         Parámetros: product (product.template), product_variant, product_href,
         display_name, image_url, card_mode, show_badge, is_best_seller.
         El badge solo se pinta cuando show_badge es True (página Best Sellers). -->
    <template id="autohaus_product_card" name="Autohaus Product Card">
        <t t-set="variant" t-value="product_variant or product.product_variant_id"/>
        <t t-set="display_name" t-value="display_name or product.name"/>
        <t t-set="product_href" t-value="product_href or product.website_url"/>
        <t t-set="image_url" t-value="image_url or (product.image_512 and ('/web/image/product.template/%s/image_512' % product.id))"/>

        <form class="o_autohaus_bs_card o_carousel_product_card o_autohaus_bs_form"
              role="article"
              data-number-of-elements="3"
              t-att-aria-label="display_name"
              t-att-data-publish="product.website_published and 'on' or 'off'">

            <div class="o_autohaus_bs_media">
                <a t-att-href="product_href" t-att-title="display_name" class="o_autohaus_bs_media_link">
                    <img t-if="image_url"
                         t-att-src="image_url"
                         t-att-alt="display_name"
                         loading="lazy"/>
                    <span t-else="" class="o_autohaus_bs_noimg">
                        <i class="fa fa-picture-o" role="presentation"/>
                    </span>
                </a>
                <span t-if="show_badge and is_best_seller" class="o_autohaus_bs_badge">Best Seller</span>
            </div>

            <div class="o_autohaus_bs_body">
                <h2 class="o_autohaus_bs_name">
                    <a t-att-href="product_href" t-out="display_name"/>
                </h2>

                <div t-if="product.finditparts_part_number" class="o_autohaus_bs_sku">
                    N&#250;mero de parte: <span t-out="product.finditparts_part_number"/>
                </div>

                <div class="o_autohaus_bs_price">
                    <t t-if="card_mode == 'shop'">
                        <t t-if="product_price" t-out="product_price"/>
                        <t t-else="">
                            <t t-set="template_price_vals" t-value="get_product_prices(product)"/>
                            <t t-set="discount_pct" t-value="0"/>
                            <t t-if="'base_price' in template_price_vals and template_price_vals['base_price'] &gt; template_price_vals['price_reduce'] and template_price_vals['price_reduce']">
                                <t t-set="discount_pct" t-value="int(round(100.0 * (1.0 - template_price_vals['price_reduce'] / template_price_vals['base_price'])))"/>
                            </t>
                            <span t-out="template_price_vals['price_reduce']"
                                  t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                            <del t-if="discount_pct &gt; 0"
                                 class="o_autohaus_bs_old_price">
                                <t t-out="template_price_vals['base_price']"
                                   t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                            </del>
                            <span t-if="discount_pct &gt; 0" class="o_autohaus_discount_badge">-<t t-out="discount_pct"/>%</span>
                        </t>
                    </t>
                    <t t-elif="card_mode == 'related'">
                        <t t-set="related_discount_pct" t-value="0"/>
                        <t t-if="data.get('has_discounted_price') and data.get('list_price') and data.get('price')">
                            <t t-set="related_discount_pct" t-value="int(round(100.0 * (1.0 - data['price'] / data['list_price'])))"/>
                        </t>
                        <span t-out="data['price']"
                              t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        <del t-if="related_discount_pct &gt; 0" class="o_autohaus_bs_old_price">
                            <t t-out="data['list_price']"
                               t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </del>
                        <span t-if="related_discount_pct &gt; 0" class="o_autohaus_discount_badge">-<t t-out="related_discount_pct"/>%</span>
                    </t>
                    <t t-else="">
                        <t t-set="best_price" t-value="product.finditparts_sale_price or product.list_price"/>
                        <t t-set="compare_price" t-value="product.compare_list_price or 0"/>
                        <t t-set="show_price_compare" t-value="compare_price and compare_price &gt; best_price"/>
                        <span t-out="best_price"
                              t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        <del t-if="show_price_compare" class="o_autohaus_bs_old_price">
                            <t t-out="compare_price"
                               t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </del>
                        <span t-if="product.finditparts_discount_percent &gt; 0" class="o_autohaus_discount_badge">-<t t-out="int(round(product.finditparts_discount_percent))"/>%</span>
                    </t>
                </div>

                <div class="o_autohaus_bs_actions">
                    <t t-if="product._website_show_quick_add() and variant">
                        <button type="button"
                                class="btn o_autohaus_bs_cart js_add_cart"
                                t-att-data-product-id="variant.id"
                                t-att-data-product-template-id="product.id"
                                t-att-data-product-type="product.type"
                                t-att-title="card_label or 'Agregar al carrito'">
                            <i class="fa fa-shopping-cart" role="presentation"/>
                            <span t-out="card_label or 'Agregar al carrito'"/>
                        </button>
                    </t>
                    <a t-else="" t-att-href="product_href" class="btn o_autohaus_bs_cart o_autohaus_bs_options">
                        Ver opciones
                    </a>

                    <t t-if="variant">
                        <t t-set="in_wish" t-value="variant._is_in_wishlist()"/>
                        <button type="button"
                                class="btn o_autohaus_bs_wish o_add_wishlist"
                                data-action="o_wishlist"
                                t-att-data-product-template-id="product.id"
                                t-att-data-product-product-id="variant.id"
                                t-att-disabled="in_wish"
                                t-att-title="in_wish and 'En tus favoritos' or 'Añadir a favoritos'"
                                aria-label="Añadir a favoritos">
                            <i t-attf-class="fa #{in_wish and 'fa-heart' or 'fa-heart-o'}" role="presentation"/>
                        </button>
                    </t>
                </div>

                <t t-if="extra_actions" t-out="extra_actions"/>
            </div>
        </form>
    </template>
</odoo>
