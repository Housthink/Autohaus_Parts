<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ==================================================================
         Autohaus Parts - Ficha de producto: datos bajo el titulo
         (OEM / numero de parte, valoracion, disponibilidad y descripcion).
         ================================================================== -->
    <template id="autohaus_product_meta"
              inherit_id="website_sale.product_title"
              name="Autohaus Product Meta"
              priority="44">

        <xpath expr="//h1" position="after">
            <div class="o_autohaus_prod_meta">
                <ul class="o_autohaus_prod_ident">
                    <li><span>OEM</span></li>
                    <li class="o_autohaus_prod_ident_alt"><span>Aftermarket</span></li>
                    <li><span>N&#250;mero de parte: <t t-esc="product.finditparts_part_number or ''"/></span></li>
                </ul>

                <div class="o_autohaus_prod_avail">
                    <span class="o_autohaus_prod_rating">
                        <i class="fa fa-star"/>
                        <i class="fa fa-star"/>
                        <i class="fa fa-star"/>
                        <i class="fa fa-star"/>
                        <i class="fa fa-star o_autohaus_star_off"/>
                        <em>(12 reseñas)</em>
                    </span>
                    <span class="o_autohaus_prod_stock">
                        <i class="fa fa-check-circle"/>
                        <t t-if="product.finditparts_has_stock">Disponible</t>
                        <t t-else="">Sin stock</t>
                        <em t-if="product.finditparts_has_stock and product.finditparts_stock &gt; 10">
                            · Más de 10 unidades en stock
                        </em>
                    </span>
                </div>

                <p t-if="product.description_sale" class="o_autohaus_prod_desc"
                   t-esc="product.description_sale"/>
            </div>
        </xpath>
    </template>

    <!-- ==================================================================
         Autohaus Parts - Ficha de producto: badge de porcentaje de descuento
         junto al precio (se apoya en el descuento aplicado por la pricelist).
         ================================================================== -->
    <template id="autohaus_product_discount_badge"
              inherit_id="website_sale.product_price"
              name="Autohaus Product Discount Badge"
              priority="44">
        <xpath expr="//span[@name='product_list_price']" position="after">
            <t t-if="combination_info.get('has_discounted_price') and combination_info.get('list_price') and combination_info.get('price')">
                <t t-set="product_discount_pct" t-value="int(round(100.0 * (1.0 - combination_info['price'] / combination_info['list_price'])))"/>
                <span t-if="product_discount_pct &gt; 0"
                      class="o_autohaus_discount_badge o_autohaus_discount_badge_product">-<t t-out="product_discount_pct"/>%</span>
            </t>
        </xpath>
    </template>

    <!-- ==================================================================
         Autohaus Parts - Ficha de producto: Consultar compatibilidad
         y fila de beneficios (debajo del boton de compra).
         La seccion de Compatibilidad no se agrega.
         ================================================================== -->
    <template id="autohaus_product_benefits"
              inherit_id="website_sale.product"
              name="Autohaus Product Benefits"
              priority="44">

        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_cta')]"
              position="after">
            <ul class="o_autohaus_prod_benefits">
                <li>
                    <i class="fa fa-truck"/>
                    <span>Envío en 2-3 días<em>a todo Panamá</em></span>
                </li>
                <li>
                    <i class="fa fa-shield"/>
                    <span>Garantía de fábrica<em>y devoluciones</em></span>
                </li>
                <li>
                    <i class="fa fa-tags"/>
                    <span>Precio OEM<em>y compatible</em></span>
                </li>
                <li>
                    <i class="fa fa-headphones"/>
                    <span>Soporte<em>especializado</em></span>
                </li>
            </ul>

            <div class="o_autohaus_prod_info_cards">
                <a class="o_autohaus_info_card" href="/devoluciones">
                    <i class="fa fa-undo"/>
                    <span class="o_autohaus_info_card_text">
                        <strong>Devolución en 30 días</strong>
                        <em>En artículos elegibles</em>
                    </span>
                    <span class="o_autohaus_info_card_link">Detalles<i class="fa fa-chevron-right"/></span>
                </a>
                <a class="o_autohaus_info_card" href="/envios">
                    <i class="fa fa-truck"/>
                    <span class="o_autohaus_info_card_text">
                        <strong>¡Envío gratis!</strong>
                        <em>Envío LTL de EE. UU. sin costo.</em>
                    </span>
                    <span class="o_autohaus_info_card_link">Detalles<i class="fa fa-chevron-right"/></span>
                </a>
            </div>

            <div class="o_autohaus_payment_methods">
                <span class="o_autohaus_payment_label">Pago seguro con</span>
                <img class="o_autohaus_payment_icon" src="/finditparts_integration/static/img/payment/visa.png" alt="Visa" loading="lazy"/>
                <img class="o_autohaus_payment_icon" src="/finditparts_integration/static/img/payment/mastercard.png" alt="Mastercard" loading="lazy"/>
                <img class="o_autohaus_payment_icon" src="/finditparts_integration/static/img/payment/amex.png" alt="American Express" loading="lazy"/>
                <img class="o_autohaus_payment_icon" src="/finditparts_integration/static/img/payment/discover.png" alt="Discover" loading="lazy"/>
                <img class="o_autohaus_payment_icon" src="/finditparts_integration/static/img/payment/paypal.png" alt="PayPal" loading="lazy"/>
                <img class="o_autohaus_payment_icon" src="/finditparts_integration/static/img/payment/ach.png" alt="ACH" loading="lazy"/>
            </div>

            <div class="o_autohaus_prod_actions">
                <a class="o_autohaus_compat_btn" href="/contactus">
                    <i class="fa fa-cogs"/>
                    <span>Consultar compatibilidad</span>
                </a>
            </div>
        </xpath>
    </template>

    <!-- ==================================================================
         Autohaus Parts - Desactiva el bloque estandar de Odoo
         "Terms and Conditions" (terminos, garantia y envio) para que la
         seccion personalizada (tarjetas de devolucion/envio y metodos de
         pago) ocupe su lugar justo debajo del boton de compra.
         ================================================================== -->
    <record id="website_sale.product_terms_and_conditions" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
</odoo>