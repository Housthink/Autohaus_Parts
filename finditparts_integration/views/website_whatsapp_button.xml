<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="autohaus_whatsapp_button"
              inherit_id="website.layout"
              name="Autohaus WhatsApp Button">
        <xpath expr="//body" position="inside">
            <t t-set="autohaus_whatsapp_url"
               t-value="request.website.get_whatsapp_url() if request.website else False"/>
            <a t-if="autohaus_whatsapp_url"
               class="o_autohaus_whatsapp"
               t-att-href="autohaus_whatsapp_url"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="WhatsApp"
               title="WhatsApp">
                <i class="fa fa-whatsapp" aria-hidden="true"/>
            </a>
        </xpath>
    </template>
</odoo>
