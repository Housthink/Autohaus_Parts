<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Campo Best Seller en la ficha del producto (pestaña Ventas) -->
    <record id="product_template_form_view_best_seller" model="ir.ui.view">
        <field name="name">product.template.form.best.seller</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale']" position="inside">
                <field name="best_seller"/>
            </xpath>
            <xpath expr="//field[@name='weight']" position="after">
                <field name="shipping_weight_unit"/>
            </xpath>
        </field>
    </record>

    <record id="delivery_carrier_form_weight_unit" model="ir.ui.view">
        <field name="name">delivery.carrier.form.weight.unit</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='max_weight']" position="after">
                <field name="weight_unit"/>
            </xpath>
        </field>
    </record>
</odoo>
