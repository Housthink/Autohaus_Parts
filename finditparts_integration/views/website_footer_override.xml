<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Simplified FinditParts-style footer with grouped navigation. -->
    <template id="autohaus_footer"
              inherit_id="portal.frontend_layout"
              name="Autohaus Parts Footer"
              priority="40">

        <xpath expr="//footer" position="after">
            <div class="o_autohaus_footer">
                <div class="o_autohaus_footer_main">
                    <div class="o_autohaus_footer_about">
                        <a href="/" aria-label="AutoHaus Parts">
                            <img t-if="website.logo" t-att-src="website.image_url(website, 'logo')" alt="AutoHaus Parts" class="o_autohaus_footer_logo"/>
                        </a>
                        <p>Repuestos confiables para mantener tu operación en movimiento.</p>
                        <a class="o_autohaus_footer_contact" href="mailto:ventas@autohauspart.com">ventas@autohauspart.com</a>
                        <a class="o_autohaus_footer_contact" href="tel:+50761003446">+507 6 100-3446</a>
                    </div>

                    <div class="o_autohaus_footer_column">
                        <h3>Compra y ayuda</h3>
                        <a href="/shop">Tienda</a>
                        <a href="/directorio-repuestos">Directorio de repuestos</a>
                        <a href="/productos">Catálogo de productos</a>
                        <a href="/envios">Información de envíos</a>
                        <a href="/devoluciones">Devoluciones</a>
                        <a href="/cores">Cores</a>
                    </div>

                    <div class="o_autohaus_footer_column">
                        <h3>AutoHaus</h3>
                        <a href="/nosotros">Nosotros</a>
                        <a href="/faq">FAQ</a>
                        <a href="/contactus">Contacto</a>
                    </div>

                    <div class="o_autohaus_footer_column">
                        <h3>Legal</h3>
                        <a href="/terminos-de-uso">Términos y condiciones</a>
                        <a href="/politica-de-privacidad">Política de privacidad</a>
                    </div>
                </div>

                <div class="o_autohaus_footer_bottom">
                    <span>© AutoHaus Parts</span>
                    <span>Avenida 17C Norte &amp; C. 74 Oeste, Panamá</span>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
