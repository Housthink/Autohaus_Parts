<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_iom" model="ir.ui.view">
        <field name="name">account.move.form.iom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_iom_emitir" type="object" string="Emitir a EBI"
                        class="btn-primary"
                        invisible="state != 'posted'"/>
                <button name="action_iom_anular" type="object" string="Anular DTE"
                        invisible="iom_estado_dte != 'aceptado'"/>
                <button name="action_iom_ver_folios" type="object" string="Ver folios"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="DTE" name="iom_dte">
                    <group>
                        <field name="iom_estado_dte"/>
                        <field name="iom_cufe"/>
                        <field name="iom_protocolo"/>
                        <field name="iom_fecha_envio"/>
                        <field name="iom_fecha_aceptacion"/>
                    </group>
                    <group string="QR">
                        <field name="iom_qr" nolabel="1"/>
                    </group>
                    <group string="Respuesta cruda">
                        <field name="iom_respuesta" nolabel="1"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_move_tree_iom" model="ir.ui.view">
        <field name="name">account.move.list.iom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="amount_total_signed" position="after">
                <field name="iom_estado_dte" optional="show"/>
                <field name="iom_cufe" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_iom" model="ir.ui.view">
        <field name="name">account.move.search.iom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="status" position="after">
                <separator string="Estado DTE"/>
                <filter name="iom_pendiente" string="No enviados"
                        domain="[('iom_estado_dte','in',('borrador','rechazado'))]"/>
                <filter name="iom_aceptado" string="Aceptados"
                        domain="[('iom_estado_dte','=','aceptado')]"/>
                <filter name="iom_anulado" string="Anulados"
                        domain="[('iom_estado_dte','=','anulado')]"/>
            </filter>
        </field>
    </record>

</odoo>
